# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
.import/
export.cfg
# export_presets.cfg 刻意不忽略：里面的 include_filter 是**功能性**配置，
# 它决定了非资源文件（比如词库 data/words/words.txt）会不会被打进导出包。
# 丢了这一行，游戏在编辑器里一切正常，装到手机上一点开始就直接结束。

# Android build artifacts
android/
build/
*.apk
*.aab
*.idsig

# Mono/C# (unused for now, kept for safety)
.mono/
data_*/
mono_crash.*.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Godot 在编辑器数据目录不可写时，会把这些目录建到工程根。
# 正常情况下不会出现，留着防止误提交。
export_templates/
feature_profiles/
script_templates/
text_editor_themes/
